{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": ""
    },
    "Jwt": {
        "Key": "super_secret_key_change_me_in_production_very_long",
        "Issuer": "",
        "Audience": "",
        "AccessTokenMinutes": 15,
        "RefreshTokenDays": 7
    },
    "AzureBlobSettings": {
        "DefaultConnection": "",
        "BaseUrl": ""
    },
    "EmailSettings": {
        "SmtpServer": "smtp.gmail.com",
        "Port": "",
        "SenderName": "",
        "SenderEmail": "",
        "Username": "",
        "Password": ""
    },
    "AutoMapper": {
        "LicenseKey": ""
    },
    "Stripe": {
        "SecretKey": "",
        "WebhookSecret": ""
    },
    "Frontend": {
        "BaseUrl": ""
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "Seq",
                "Args": { "serverUrl": "http://localhost:5341" }
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
        "Properties": {
            "App": "Nois.API"
        }
    }
}
